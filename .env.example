# scripts/configure-local.ps1 generates the ignored .env password.
HOTRADAR_DB_HOST=127.0.0.1
HOTRADAR_DB_PORT=18814
HOTRADAR_DB_NAME=hotradar
HOTRADAR_DB_USER=hotradar
HOTRADAR_DB_PASSWORD=
HOTRADAR_COLLECTION_INTERVAL=900
HOTRADAR_REQUEST_TIMEOUT=20
HOTRADAR_TIMEZONE=Asia/Shanghai
# Generate a Fernet key with scripts/configure-platform-sessions.py.
HOTRADAR_SESSION_KEY=
# Optional browser channel. Windows tries Edge, Chrome, and Playwright Chromium.
# HOTRADAR_BROWSER_CHANNEL=chrome
# Keep the API and worker on the same private volume when deploying separately.
# HOTRADAR_SESSION_DIR=/var/lib/hotradar/sessions
# Optional HTTP(S) proxy with a verified Wuxi egress, only for the public native city board.
# HOTRADAR_DOUYIN_WUXI_PROXY=http://wuxi-egress.example:3128
